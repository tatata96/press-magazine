SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts the buyer-details cookie.
BUYER_COOKIE_SECRET=your-base64-32-byte-secret
# Staging only: set to "true" to allow placeholder legal text and checkout outside development.
# Leave unset in production; with placeholders left, checkout and the legal pages stay closed.
# ALLOW_PLACEHOLDER_LEGAL=true

# Customer Account API (Phase 0 auth spike). Confidential client from the Headless channel.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-customer-account-client-secret
# 32 random bytes, base64-encoded. Encrypts the customer session cookie (separate from BUYER_COOKIE_SECRET).
CUSTOMER_SESSION_SECRET=your-base64-32-byte-secret
# Exact origin registered as the callback host in the Customer Account API settings.
# APP_ORIGIN=https://your-preview-host.vercel.app
# Throwaway auth spike routes (/api/auth/*). Only honoured in development and Vercel previews;
# ignored in production and on pressmagazine.com.tr whatever its value. Never set in production.
# AUTH_SPIKE_ENABLED=true
