SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts the buyer-details cookie.
BUYER_COOKIE_SECRET=your-base64-32-byte-secret
# Staging only: set to "true" to allow placeholder legal text and checkout outside development.
# Leave unset in production; with placeholders left, checkout and the legal pages stay closed.
# ALLOW_PLACEHOLDER_LEGAL=true
