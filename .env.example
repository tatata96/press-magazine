SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Staging only: set to "true" to allow placeholder legal text and checkout outside development.
# Leave unset in production; with placeholders left, checkout and the legal pages stay closed.
# ALLOW_PLACEHOLDER_LEGAL=true

# Customer Account API (sign-in, /account, authenticated checkout). Confidential client from the
# Headless channel's Customer Account API settings.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-customer-account-client-secret
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts the customer session cookie.
CUSTOMER_SESSION_SECRET=your-base64-32-byte-secret
# The one origin Shopify redirects back to, with no trailing slash, e.g. https://pressmagazine.com.tr.
# Required in every environment. For a Vercel preview use its stable branch URL, and register
# <APP_ORIGIN>/api/auth/callback and <APP_ORIGIN>/ as the callback and logout URIs in Shopify.
APP_ORIGIN=https://your-domain.example
